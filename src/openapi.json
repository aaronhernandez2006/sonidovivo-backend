      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT de acceso. El ejemplo es ficticio y no es un token válido."
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "string",
            "example": "1h"
          },
          "usuario": {
            "$ref": "#/components/schemas/Usuario"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "usuario"
        ]
      },
