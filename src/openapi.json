            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "description": "La API requiere 8 a 72 bytes UTF-8. No se almacena ni devuelve en texto plano."
          }
        },
        "required": [
          "nombre",
          "email",
          "password"
        ]
      },
      "LoginInput": {
        "type": "object",
        "properties": {
